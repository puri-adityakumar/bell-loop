{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Bell Loop benchmark result frontmatter",
  "type": "object",
  "required": [
    "benchmark",
    "result_id",
    "provider",
    "model",
    "branch",
    "base_branch",
    "base_commit",
    "status",
    "pass_count",
    "persisted_agents",
    "non_cache_tokens",
    "total_tokens"
  ],
  "properties": {
    "benchmark": { "const": "bell-loop" },
    "result_id": { "type": "string", "minLength": 1 },
    "provider": { "type": "string", "minLength": 1 },
    "model": { "type": "string", "minLength": 1 },
    "variant": { "type": "string" },
    "branch": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._/-]+$" },
    "base_branch": { "const": "main" },
    "base_commit": { "type": "string", "minLength": 7 },
    "status": { "enum": ["draft", "candidate", "verified", "archived"] },
    "run_count": { "type": "integer", "minimum": 0 },
    "pass_count": { "type": "integer", "minimum": 0 },
    "task_calls": { "type": "integer", "minimum": 0 },
    "persisted_agents": { "type": "integer", "minimum": 0 },
    "general_agents": { "type": "integer", "minimum": 0 },
    "explore_agents": { "type": "integer", "minimum": 0 },
    "wall_time_ms": { "type": "integer", "minimum": 0 },
    "active_agent_time_ms": { "type": "integer", "minimum": 0 },
    "input_tokens": { "type": "integer", "minimum": 0 },
    "output_tokens": { "type": "integer", "minimum": 0 },
    "reasoning_tokens": { "type": "integer", "minimum": 0 },
    "cache_read_tokens": { "type": "integer", "minimum": 0 },
    "cache_write_tokens": { "type": "integer", "minimum": 0 },
    "non_cache_tokens": { "type": "integer", "minimum": 0 },
    "total_tokens": { "type": "integer", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 },
    "pure_checks": { "type": "integer", "minimum": 0 },
    "world_checks": { "type": "integer", "minimum": 0 },
    "build": { "type": "string" },
    "deployed_url": { "type": "string" },
    "screenshots": { "type": "array", "items": { "type": "string" } }
  }
}
